#!/bin/zsh --no-rcs

#  Postinstall script for outset CLI
#
#  Created by Bart Reardon on 9/1/2023.
#

# Get the macOS version number
macos_version="$(sw_vers -productVersion)"
LD_ROOT="/Library/LaunchDaemons"
LA_ROOT="/Library/LaunchAgents"

APP_PATH="/usr/local/outset/Outset.app"
APP_ROOT="${APP_PATH}/Contents"

# register the app bundle
/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister "${APP_PATH}"

# The managed log directory belongs to root alone: root:wheel 0755, files 0644.
# User-context runs log to ~/Library/Logs/Managed State instead. A symlink or
# anything other than a real folder at either level is refused, not followed.
# Builds before this one made the folder world-writable (1777) and its files
# 0666; the --boot run below resets everything inside it to root's and drops
# any symlink or hard link it finds there.
MANAGED_STATE_DIR="/Library/Managed State"
MANAGED_LOG_DIR="${MANAGED_STATE_DIR}/logs"
managed_log_dir_ok=1
for dir in "${MANAGED_STATE_DIR}" "${MANAGED_LOG_DIR}"; do
    if [ -L "${dir}" ] || { [ -e "${dir}" ] && [ ! -d "${dir}" ]; }; then
        echo "Refusing ${dir}: it is not a real folder. Root logs stay off it."
        managed_log_dir_ok=0
        break
    fi
    /bin/mkdir -p -m 755 "${dir}"
    /usr/sbin/chown -h root:wheel "${dir}"
    /bin/chmod -h 755 "${dir}"
done

# move any existing log history from the previous log location into the managed log directory
LEGACY_LOG_DIR="/usr/local/outset/logs"
if [ ${managed_log_dir_ok} -eq 1 ] && [ -d "${LEGACY_LOG_DIR}" ] && [ ! -L "${LEGACY_LOG_DIR}" ]; then
    for logfile in "${LEGACY_LOG_DIR}"/outset.log*(N); do
        if [ ! -e "${MANAGED_LOG_DIR}/${logfile:t}" ]; then
            /bin/mv "${logfile}" "${MANAGED_LOG_DIR}/"
        fi
    done
    /bin/rmdir "${LEGACY_LOG_DIR}" 2>/dev/null
fi

# run boot argument - creates necessary paths and folders, and as root locks
# the managed log directory and everything in it
"${APP_PATH}/Contents/MacOS/Outset" --boot

### Commented out for now until issues with SMAppService are sorted
# Check if the macOS version is 13 or newer. If so, we don't need to load the launchd plists manually.
#if [[ $(echo "${macos_version}" | cut -d'.' -f1) -ge 13 ]]; then
#    # register the agents
#    "${APP_PATH}/Contents/MacOS/Outset" --enable-services
#
#    # issue with ServiceManagement in that login-window agents don't get loaded so we'll copy that one over manually
#    cp "${APP_ROOT}/${LA_ROOT}/io.macadmins.outset.login-window.plist" "${LA_ROOT}"
#    exit 0
#fi
###

## LaunchDaemons
DAEMONS=(
  "${LD_ROOT}/io.macadmins.outset.boot.plist"
  "${LD_ROOT}/io.macadmins.outset.cleanup.plist"
  "${LD_ROOT}/io.macadmins.outset.login-privileged.plist"
  "${LD_ROOT}/io.macadmins.outset.on-demand-privileged.plist"
)

## LaunchAgents
AGENTS=(
  "${LA_ROOT}/io.macadmins.outset.login.plist"
  "${LA_ROOT}/io.macadmins.outset.on-demand.plist"
  "${LA_ROOT}/io.macadmins.outset.login-window.plist"
)

for daemon in ${DAEMONS}; do
    cp "${APP_ROOT}/${daemon}" "${LD_ROOT}"
    if [ -e "${daemon}" ]; then
        /bin/launchctl bootstrap system "${daemon}"
    fi
done

for agent in ${AGENTS}; do
    cp "${APP_ROOT}/${agent}" "${LA_ROOT}"
    echo ${agent}
done

# Managed State Keeper ships in this package: install its privileged helper.
# A failure there is logged but leaves the outset install itself successful.
MSK_POSTINSTALL="${0:A:h}/managedstatekeeper-postinstall"
if [ -x "${MSK_POSTINSTALL}" ]; then
    "${MSK_POSTINSTALL}" "$@" || echo "Managed State Keeper helper setup failed; see /private/tmp/managedstatekeeper-postinstall.log"
fi

exit 0
